# Frontend (aman dipublikasikan: anon/publishable key dilindungi RLS). Kosongkan untuk mode demo.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Secret Edge Functions: JANGAN diberi prefix VITE_ dan jangan masuk frontend.
# Set lewat: supabase secrets set --env-file supabase/.env.local
# (SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY disediakan otomatis oleh platform.)
RATE_LIMIT_SALT=GANTI-DENGAN-STRING-ACAK-PANJANG
ALLOWED_ORIGINS=http://localhost:5173,https://domain-kamu.vercel.app
